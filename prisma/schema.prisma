// Base PostgreSQL, montée par `docker compose up -d`.
//
// Le projet a démarré sur SQLite, avec un schéma volontairement gardé
// compatible : aucune requête SQL brute, aucun type exotique. La bascule
// n'a donc demandé que ce mot — et c'est le préalable à toute app mobile,
// un téléphone ne pouvant pas se connecter au fichier local d'un PC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connexion **poolée** en production : en serverless, chaque invocation
  // ouvre sa propre connexion et une base managée est vite saturée.
  url = env("DATABASE_URL")
  // Connexion directe, réservée aux migrations : un pooler transactionnel
  // comme PgBouncer ne sait pas exécuter un DDL. En local, les deux pointent
  // sur la même instance.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth.js — modèles standard, avec champs métier ajoutés sur User
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // --- Métier ---
  onboarded   Boolean @default(false)
  heightCm    Int?
  goal        Goal    @default(HYPERTROPHIE)
  level       Level   @default(DEBUTANT)
  /// Jours d'entraînement par semaine, 2 à 6, choisi à l'onboarding
  daysPerWeek Int     @default(3)
  /// LP cumulés. Jamais négatifs : aucune action n'en retire.
  lp          Int     @default(0)

  /// Code personnel à partager pour être ajouté à une phalange.
  ///
  /// Il n'existe **aucune recherche par nom ou par adresse** : pouvoir chercher
  /// quelqu'un reviendrait à pouvoir savoir qui a un compte. Le code est le
  /// seul chemin, et il ne circule que si son porteur le donne.
  ///
  /// Créé à la demande, jamais à l'inscription : la plupart des comptes n'en
  /// auront jamais besoin. Régénérable — il ne déclenche qu'une demande, qui
  /// doit ensuite être acceptée, si bien qu'un code égaré ne coûte au pire
  /// qu'une sollicitation à refuser.
  codeAmi     String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  sessions     Session[]
  equipments   UserEquipment[]
  muscleGroups UserMuscleGroup[]
  weighIns     WeighIn[]
  workouts     WorkoutLog[]
  planDays     PlanDay[]
  charges      ExerciseLoad[]
  apiTokens    ApiRefreshToken[]
  handoffCodes ApiHandoffCode[]

  amitiesDemandees Amitie[] @relation("AmitiesDemandees")
  amitiesRecues    Amitie[] @relation("AmitiesRecues")
}

/// Lien entre deux comptes — demandé, accepté ou refusé.
///
/// Une seule ligne par paire, quel que soit le sens. La contrainte qui le
/// garantit porte sur `paire`, la concaténation des deux identifiants **triés**
/// : sans elle, A→B et B→A pourraient coexister, et deux demandes croisées
/// envoyées en même temps produiraient deux amitiés entre les mêmes personnes.
/// Vérifier l'absence de réciproque en amont ne suffirait pas — deux requêtes
/// simultanées passeraient toutes deux le contrôle avant que l'une n'écrive.
///
/// Le sens reste porté par `demandeurId` / `destinataireId` : seul le
/// destinataire peut accepter, et l'un comme l'autre peut rompre.
model Amitie {
  id             String       @id @default(cuid())
  demandeurId    String
  destinataireId String
  statut         StatutAmitie @default(EN_ATTENTE)

  /// `[demandeurId, destinataireId].sort().join(":")`. Voir la note du modèle.
  paire String @unique

  createdAt DateTime  @default(now())
  reponduLe DateTime?

  demandeur    User @relation("AmitiesDemandees", fields: [demandeurId], references: [id], onDelete: Cascade)
  destinataire User @relation("AmitiesRecues", fields: [destinataireId], references: [id], onDelete: Cascade)

  @@index([demandeurId, statut])
  @@index([destinataireId, statut])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Référentiels (alimentés par le seed)
// ---------------------------------------------------------------------------

model Equipment {
  /// Slug : "halteres", "banc", "barre_dc", "tapis_course",
  /// "elastiques", "barre_traction", "kettlebell", "corde_a_sauter"
  id    String @id
  label String

  users UserEquipment[]
}

model UserEquipment {
  userId      String
  equipmentId String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([userId, equipmentId])
}

model MuscleGroup {
  /// Slug : "pectoraux", "dos", "epaules", "bras", "jambes", "abdos", "cardio"
  id    String @id
  label String

  users UserMuscleGroup[]
}

model UserMuscleGroup {
  userId  String
  groupId String
  /// 1 = priorité normale, 2 = point fort souhaité
  priority Int @default(1)
  /// Décalage de difficulté sur ce groupe, -1 à +1, piloté par le ressenti
  /// de fin de séance. S'ajoute au niveau déclaré pour choisir les variantes :
  /// un débutant à +1 accède aux mouvements intermédiaires de ce groupe.
  levelOffset Int @default(0)

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  group MuscleGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
}

model Exercise {
  id String @id @default(cuid())

  name String
  /// FK logique vers MuscleGroup.id
  muscleGroup String
  /// "aucun" = poids de corps. Sinon slug(s) Equipment, séparés par "+"
  /// quand plusieurs sont requis (ex. "banc+halteres").
  equipment String @default("aucun")
  /// Niveau minimum requis
  level       Level   @default(DEBUTANT)
  type        ExoType @default(POLYARTICULAIRE)
  /// Consignes d'exécution, 1 à 2 phrases
  description String
  /// Nom de la variante plus difficile, proposée automatiquement quand
  /// l'utilisateur dépasse la fourchette haute de reps deux séances de suite.
  progression String?

  @@unique([name])
  @@index([muscleGroup, level])
}

// ---------------------------------------------------------------------------
// Données utilisateur
// ---------------------------------------------------------------------------

model PlanDay {
  id     String @id @default(cuid())
  userId String
  /// Jour du calendrier, normalisé à minuit UTC
  date        DateTime
  muscleGroup String
  status      PlanStatus @default(PREVU)
  /// Rempli à la validation de la séance
  workoutId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, muscleGroup])
  @@index([userId, date])
}

model WorkoutLog {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime
  muscleGroup String
  isBonus     Boolean  @default(false)
  lpEarned    Int
  /// Snapshot : [{name, sets, reps, restSec, done, weightUsedKg?}]
  exercises   Json
  durationMin Int?
  /// Ressenti post-séance, 1 à 5
  feeling Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

/// Charge courante par exercice — la dernière utilisée.
///
/// Table dédiée plutôt qu'une lecture dans le JSON des `WorkoutLog` : c'est
/// consulté à chaque affichage de séance, et fouiller un snapshot JSON pour y
/// retrouver la dernière occurrence d'un nom d'exercice ne s'indexe pas.
model ExerciseLoad {
  userId String
  /// Nom de l'exercice, tel que dans le catalogue.
  exerciseName String
  kg           Float
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, exerciseName])
}

/// Jeton de rafraîchissement de l'API mobile.
///
/// Les sessions par cookie ne conviennent pas à une app native : elle porte un
/// jeton d'accès court en en-tête, et le renouvelle avec celui-ci. Seul le
/// condensat est stocké — une fuite de la base ne rend aucun jeton utilisable.
model ApiRefreshToken {
  id        String   @id @default(cuid())
  userId    String
  /// SHA-256 du jeton. Le jeton en clair n'existe que chez le client.
  tokenHash String   @unique
  /// Libellé d'appareil, pour que l'utilisateur puisse révoquer un téléphone perdu.
  appareil  String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  /// Renseigné à la rotation ou à la déconnexion.
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Code de relais entre le navigateur et l'app mobile, à usage unique.
///
/// La connexion Google native exige d'enregistrer un schéma d'URL propre à
/// l'app, ce qu'Expo Go ne peut pas faire. On passe donc par le navigateur :
/// il mène le flux web habituel, puis renvoie vers l'app un code éphémère que
/// celle-ci échange contre ses jetons. Le code transite par une URL — d'où sa
/// durée de vie très courte et son usage unique.
model ApiHandoffCode {
  id        String   @id @default(cuid())
  userId    String
  /// SHA-256 du code. Le code en clair ne vit que dans l'URL de retour.
  codeHash  String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeighIn {
  id     String   @id @default(cuid())
  userId String
  date   DateTime
  kg     Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// ---------------------------------------------------------------------------

enum Goal {
  HYPERTROPHIE
  FORCE
  ENDURANCE
  PERTE_DE_POIDS
}

enum Level {
  DEBUTANT
  INTERMEDIAIRE
  AVANCE
}

enum ExoType {
  POLYARTICULAIRE
  ISOLATION
  CARDIO
}

enum PlanStatus {
  PREVU
  FAIT
  MANQUE
  REPOS
}

/// Un refus est **conservé** plutôt que supprimé : la ligne subsiste, et la
/// contrainte d'unicité sur `paire` empêche alors le demandeur d'insister. Le
/// supprimer laisserait la voie libre à une nouvelle demande dans la seconde,
/// autant de fois que voulu — un code partagé publiquement suffirait à harceler
/// son porteur. Celui qui a refusé peut revenir dessus : retirer la ligne rouvre
/// la porte, accepter la franchit.
enum StatutAmitie {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}
