# Copier ce fichier en `.env` et remplir les valeurs.
# Sous Windows, écrire le .env en UTF-8 SANS BOM : un BOM casse la lecture
# de la première clé.

# --- Base de données ---
# PostgreSQL, monté par `docker compose up -d`. Le port 5433 évite le conflit
# avec une instance Postgres déjà installée sur la machine.
DATABASE_URL="postgresql://lafaille:lafaille@localhost:5433/lafaille?schema=public"
# Connexion directe, utilisée par les migrations. En local, la même que ci-dessus ;
# en production, la chaîne non poolée fournie par l'hébergeur de base.
DIRECT_URL="postgresql://lafaille:lafaille@localhost:5433/lafaille?schema=public"

# --- Auth.js v5 ---
# Générer avec : npx auth secret   (ou openssl rand -base64 32)
AUTH_SECRET=""

# --- Fournisseurs d'identité ---
# Chacun s'active seul, à la présence de ses variables. Une variable créée
# SANS VALEUR compte pour absente : le fournisseur n'apparaîtra pas.
# Il en faut au moins un : l'app n'a pas de mot de passe.

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (type « Web application »), redirect URI :
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Client OAuth de type iOS (app native). Pas de secret pour ce type de client.
AUTH_GOOGLE_ID_IOS=""

# Apple : quatre valeurs, car son « secret » est un jeton signé que l'app
# fabrique elle-même (lib/fournisseurs.ts) plutôt qu'une chaîne à recopier.
#   AUTH_APPLE_ID          identifiant de SERVICE (pas le bundle de l'app iOS)
#   AUTH_APPLE_TEAM_ID     Membership -> Team ID
#   AUTH_APPLE_KEY_ID      Keys -> la clé « Sign in with Apple »
#   AUTH_APPLE_PRIVATE_KEY contenu du .p8, sauts de ligne littéraux ou échappés
# Apple refuse http:// et localhost : cette connexion ne s'éprouve qu'en ligne.
AUTH_APPLE_ID=""
AUTH_APPLE_TEAM_ID=""
AUTH_APPLE_KEY_ID=""
AUTH_APPLE_PRIVATE_KEY=""

# Identifiant de bundle de l'app iOS (com.frameoflegends.app). La connexion
# Apple NATIVE émet son jeton pour lui, et non pour l'identifiant de service
# utilisé par le navigateur : sans cette variable, le serveur refuse les
# connexions Apple venues de l'app.
AUTH_APPLE_ID_IOS=""

# Discord Developer Portal -> Applications -> OAuth2, redirect :
#   http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Origine du site. À laisser vide en production sur Vercel : Auth.js déduit
# l'hôte de la requête, et une valeur périmée ici RÉÉCRIT l'origine de chaque
# requête — l'URI de redirection envoyée au fournisseur devient alors fausse.
AUTH_URL="http://localhost:3000"
