# Copier ce fichier en `.env` et remplir les valeurs.
# Sous Windows, écrire le .env en UTF-8 SANS BOM : un BOM casse la lecture
# de la première clé.

# --- Base de données ---
# SQLite local. Le chemin est relatif au dossier prisma/.
DATABASE_URL="file:./dev.db"

# --- Auth.js v5 ---
# Générer avec : npx auth secret   (ou openssl rand -base64 32)
AUTH_SECRET=""

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (type « Web application »), redirect URI :
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

AUTH_URL="http://localhost:3000"
